# Copy this file to .env and fill in your real calendar feed URLs.
# .env is gitignored — it never gets committed or pushed to GitHub.
# The same JSON goes into a GitHub Secret named CALENDAR_FEEDS_JSON
# for the scheduled workflow (see README.md).

CALENDAR_FEEDS_JSON=[{"name":"Meals","url":"https://calendar.google.com/calendar/ical/xxx/private-xxx/basic.ics","color":"#000000","kind":"meal"},{"name":"Papa","url":"https://calendar.google.com/calendar/ical/yyy/private-yyy/basic.ics","color":"#000000","kind":"event"}]

# Optional — defaults to Portland, OR if omitted
WEATHER_LATITUDE=45.5152
WEATHER_LONGITUDE=-122.6784
